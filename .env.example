# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the secrets.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres with pgvector (docker compose locally, Neon/Supabase in production)
DATABASE_URL="postgresql://recall:recall@localhost:5432/recall"

# Redis: document queue and rate limiting (docker compose locally, Upstash in production)
# Must start with redis:// or rediss://
REDIS_URL="redis://localhost:6379"

# Auth.js session signing key. Required, at least 32 characters. Generate one with:
#   npx auth secret
#   openssl rand -base64 32
AUTH_SECRET=""

# Public origin of the app. Required in production; on Vercel it is derived
# automatically from the deployment URL. Locally: http://localhost:3000
AUTH_URL=""

# OpenRouter API key for chat and embeddings (required for AI features).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional. Where uploaded files are written when no object storage is used.
# Defaults to "uploads" locally and to a folder in /tmp on Vercel (ephemeral).
# UPLOAD_DIR="/tmp/recall-uploads"

# Optional: "queue" (BullMQ worker) or "inline" (process after the response).
# Defaults to "queue" locally and to "inline" on Vercel, where no worker runs.
# DOCUMENT_PROCESSING="inline"
